# Copy to .env and fill in. Never commit the real .env — it's in .gitignore.

# Required
DATABASE_URL=postgres://user:password@host/dbname
JWT_SECRET=          # long random string, e.g: openssl rand -hex 32
FRONTEND_URL=http://localhost:3000   # used to build invite-email links; set to your real domain in production

# Optional — WhatsApp notifications via Twilio. Without these, notifications
# log to the console in mock mode instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional — Email notifications via Resend. Requires a domain verified in
# Resend (SPF/DKIM records added to your DNS) before FROM will actually send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CC Manager <alerts@cat-cons.com>

PORT=3001
NODE_ENV=development
